@misc{jaramillo,
  author = {Jaramillo Ana María},
  title = {Acústica: la ciencia del sonido},
  year = {2007},
  abstract = {"En nuestro medio, la acústica ha sido uno de los campos menos valorados de la física y, en general, de la ciencia. Cuando los ingenieros se ponen a la cabeza de las investigaciones en el área, con frecuencia reducen el problema a una cuestión de números. Algunos arquitectos se han aproximado, también, a la tarea y han encontrado una barrera en su formación técnica a la hora de resolver problemas eficientemente. Los músicos no se han quedado atrás en aportar si cuota de conocimientos en el tratamiento acústico de los recintos, dejando su estudio a una cuestión de ""oído"" . Y mientras ningún profesional se pone en la tarea de capacitar para controlar todos los aspectos a la vez (Técnico y estéticos), a la ciudad se le llena de espacios pobres en calidad acústica y de público que no exigen calidad, pues ignoran la diferencia. Hoy empieza a reconocerse la importancia de la acústica en el diseño de los espacios, factor decisivo para el confort humano. Las facultades de ingeniería, diseño y música empiezan a incluir esta ciencia dentro de sus áreas de formación. Acústica: La ciencia del sonido pretende ser una guía para el estudio de la acústica de aquellos que por primera vez se aproximan a este campo."},
  url = {http://hdl.handle.net/20.500.12622/1763}
}

